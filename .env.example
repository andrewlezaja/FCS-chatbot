# Copy to .env and fill in. .env is git-ignored.

# Required: every Claude call (chatbot.py, streamlit_app.py, eval.py)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed to sync real data from MaintainX (sync.py / in-app refresh).
# Without it the app runs on the fictional demo dataset in db/demo.db.
MAINTAINX_API_KEY=

# Optional: force a specific SQLite file instead of the default
# (db/mx_data.db if present, else db/demo.db).
# MX_DB_PATH=db/demo.db
